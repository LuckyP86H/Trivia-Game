# Optional, and only for the Supabase leaderboard. The default leaderboard needs no configuration:
# it uses this site's own Cloudflare Worker. Without a backend the game works fully offline.
# Both values are public by design (the anon key is protected by row-level security).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
