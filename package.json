{
  "name": "trivia-game",
  "version": "2.0.0",
  "private": true,
  "description": "Stack Quiz: a timed data and backend trivia game with spaced repetition, built on Vue 3.",
  "author": "Paul Xu",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm db:migrate:local && vite",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm db:migrate:local && vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "knip": "knip",
    "cf:deploy": "pnpm build && wrangler deploy",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e && pnpm knip",
    "prepare": "node scripts/prepare.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.16",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.5",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "~5.1.0",
    "knip": "^6.44.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "~5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.157.0"
  }
}
